# Copy this file to .env and fill in real values. Never commit .env.

PORT=5000
MONGO_URI=mongodb://localhost:27017/mednex
JWT_SECRET=replace-with-a-long-random-string

# Frontend URL — used to build the password-reset link that gets emailed.
FRONTEND_URL=http://localhost:5173

# ---- Cloudinary (doctor photo / QR code uploads) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Razorpay (doctor subscription payments) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- SMTP (password-reset emails) ----
# Any SMTP provider works. For Gmail specifically:
#   1. Turn on 2-Step Verification on the Google account:
#      https://myaccount.google.com/security
#   2. Go to https://myaccount.google.com/apppasswords and generate an
#      "App Password" for "Mail" — it's a 16-character code.
#   3. Use that 16-character code as SMTP_PASS below — NOT the normal
#      Gmail login password (Google blocks normal-password SMTP logins).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM_EMAIL=your@gmail.com
SMTP_FROM_NAME=MedNex

# ---- Web Push / VAPID (browser push notifications) ----
# A working keypair is pre-filled below so push works out of the box in
# dev — for production, generate your own with:
#   npx web-push generate-vapid-keys
# and replace both values (keep them secret, especially the private key).
VAPID_PUBLIC_KEY=BGbzIrKAprDoYwDYZ0at43Y6Zl0-UPBWhlyJ7NMR8oPqUWhzJz3DYW4VEIju8UNamHihbaX8QQkC-ziCTnH2OP0
VAPID_PRIVATE_KEY=Innna9Qr29MCE5wINMAMUca9RwmQ_pryHR3fiXLBOo4
VAPID_CONTACT_EMAIL=mailto:admin@example.com
